# Copy to backend/.env for local overrides. Never commit a filled-in .env.
# Default is mock/offline mode: no AWS credentials required.

# auto | extractive | llm
GENERATOR_MODE=auto

# Opt in to real AWS (Bedrock Retrieve, Bedrock Converse, DynamoDB).
# Leave unset/false for local-dev and tests.
ABW_USE_AWS=false

AWS_REGION=us-east-1
# Optional: a named profile in ~/.aws/credentials (never commit the file).
# AWS_PROFILE=abw-dev

BEDROCK_KB_ID=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

DDB_TABLE_PREFIX=abw-connect
S3_KB_BUCKET=
S3_KB_PREFIX=kb/

ABW_EVENT_YEAR=2026
ABW_RETRIEVE_K=12
LLM_TIMEOUT_S=15
REWRITE_TIMEOUT_S=4
CHAT_HISTORY_TURNS=6

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Hex commit for /api/health git_sha. Not a secret. Leave unset locally.
# ABW_GIT_SHA=
