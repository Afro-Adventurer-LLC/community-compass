# Copy to .env.local for local development (.env.local is git-ignored).
#
# Where `next dev` proxies /abw-api/* to: the base URL of a deployed ABW Connect API
# (ask the team for the staging API base), or http://localhost:8000 for a local backend.
ABW_API_PROXY_TARGET=

# Only for `npm run build` on your machine: export this in your shell first (the build check
# does not read .env files). It is the API base baked into the static export.
# The deploy workflow sets this itself from Terraform; never commit a real value.
# NEXT_PUBLIC_ABW_API_BASE=http://localhost:8000
